# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this in the server environment or a local .env file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model identifier for qualitative proposal evaluation.
# Configurable outside the app (e.g. gemini-2.5-flash, gemini-3.1-pro-preview, gemini-3.1-flash-lite).
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where the application is hosted.
# Set this to the deployed application URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
